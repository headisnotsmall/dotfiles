{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "WebFetch(domain:www.cpbl.com.tw)",
      "WebFetch(domain:publish.obsidian.md)",
      "WebFetch(domain:github.com)",
      "WebSearch",
      "Skill(update-config)",
      "Bash(pip install *)",
      "Bash(playwright install *)",
      "Bash(python3 *)",
      "Bash(docker --version)",
      "Bash(docker compose *)",
      "Bash(systemctl is-active *)",
      "Bash(git config *)",
      "Bash(git clone *)",
      "Bash(gh --version)",
      "Bash(gh repo *)",
      "Bash(gh auth *)",
      "Bash(sudo apt *)",
      "Bash(mv *)",
      "Bash(mount)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "/home/niels"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "printf '%s\\033[01;32m%s@%s\\033[00m:\\033[01;34m%s\\033[00m' \"${debian_chroot:+($debian_chroot)}\" \"$(whoami)\" \"$(hostname -s)\" \"$(pwd)\""
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "preferredNotifChannel": "auto",
  "agentPushNotifEnabled": true
}
